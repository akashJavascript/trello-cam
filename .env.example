# Copy to .env (gitignored) and fill in. Never commit .env.
# Environment variables with the same names override this file.

# Trello: API key + token for the account the service acts as (a bot account or a mentor's).
TRELLO_API_KEY=
TRELLO_TOKEN=

# Onshape: API keys for the dedicated team account inside the enterprise.
# Every Onshape call counts against the enterprise's shared 10,000 calls/year.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# The Onshape panel (panel/): a long random string. The extension's link in Onshape carries it, and the
# panel's server refuses every request without it. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOCAM_PANEL_KEY=

# Onshape's company webhook (panel/hooks.py): another long random string, the end of the address Onshape calls when a
# model changes. Only the service and Onshape know it (the service registers the webhook itself). Optional: without
# it, changes are found by the periodic checks. Make one the same way as the panel key.
AUTOCAM_WEBHOOK_SECRET=

# The team's order sheet (bought.py, docs/bought-parts.md): the phone page's Order button opens it. Not a secret, but
# kept here instead of config/autocam.toml because the repo is public and the sheet has students' names. Optional:
# without it there's no Order button. A Google Sheets link ("/u/3/" and "#gid=" are taken off by themselves).
AUTOCAM_ORDER_SHEET_URL=
